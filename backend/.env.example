# API Configuration
API_V1_STR=/api
PROJECT_NAME=Motor Biomecânico Paramétrico
PROJECT_VERSION=0.1.0

# Server
HOST=0.0.0.0
PORT=8000
RELOAD=true
LOG_LEVEL=info

# Database
DATABASE_URL=sqlite:///./motor_biomecanico.db
# Exemplo PostgreSQL: postgresql://user:password@localhost:5432/motor_biomecanico

# CORS - Development (permissivo)
CORS_ORIGINS=["*"]
# Em produção: ["http://localhost:5173", "https://app.domain.com"]

# Features
ENABLE_LEARNING=true
ENABLE_PRESSURE_SIMULATION=true
ENABLE_3D_EXPORT=true

# Limits
MAX_UPLOAD_SIZE_MB=50
MAX_CASES_PER_PATIENT=1000

# Suggestion Engine Thresholds
CONFIDENCE_THRESHOLD_MIN=0.65
CONFIDENCE_THRESHOLD_DEFAULT=0.75

# Security (Change in production!)
SECRET_KEY=your-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Paths
EXPORT_PATH=/tmp/exports
UPLOAD_PATH=/tmp/uploads
